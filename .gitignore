# Ignore rules for the Go module (repository root) and the Python package
# (python/). Directory names that could also be real package directories are
# anchored with a leading "/".

# --- Go ----------------------------------------------------------------------

# Test binaries (go test -c) and native build outputs
*.test
*.exe
*.exe~
*.dll
*.so
*.dylib
/bin/

# Coverage profiles and reports (make coverage writes coverage.out)
coverage.out
cover.out
*.coverprofile
coverage.html

# Profiles
*.prof
*.pprof

# Local workspace files and vendored dependencies
go.work
go.work.sum
/vendor/

# --- Python (python/) --------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class
*.egg-info/
/python/build/
/python/dist/

# Virtual environments
.venv/
venv/

# Test, type-checker and linter caches and reports
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.hypothesis/
.benchmarks/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml
bandit-report.json
safety-report.json

# --- Local settings ----------------------------------------------------------

# .env can hold local overrides, e.g. the docker-compose.yml credentials.
.env
.env.local
.env.*.local

# --- Editors and operating systems -------------------------------------------

.idea/
# Shared VS Code settings may be committed; everything else there is local.
# "**/" also covers python/.vscode/ (a bare ".vscode/*" matches only at the root).
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/extensions.json
*.swp
*.swo
*~
.#*
\#*#
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# --- Logs, local databases, backups and scratch space ------------------------

*.log
*.db
*.sqlite
*.sqlite3
*.bak
*.backup
/tmp/
/temp/
